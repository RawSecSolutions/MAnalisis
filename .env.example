# ============================================================
# Variables de entorno para el Malware Analysis Lab
# Copia este fichero a .env y rellena los valores
# ============================================================

# API Key de VirusTotal v3
# Obtener en: https://www.virustotal.com/gui/my-apikey
VT_API_KEY=your_virustotal_api_key_here

# (Opcional) MalwareBazaar no requiere API key para lookups
# pero puedes configurar una clave para subidas
# MB_API_KEY=your_malwarebazaar_key_here

# Umbral de entropía para clasificar como sospechoso (default: 7.0)
# ENTROPY_THRESHOLD=7.0

# Interfaz de red por defecto para tcpdump
# NETWORK_INTERFACE=eth0
